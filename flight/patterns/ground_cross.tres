[gd_resource type="Resource" script_class="FlightPattern" format=3]

[ext_resource type="Script" path="res://flight/flight_pattern.gd" id="1_pattern"]
[ext_resource type="Script" path="res://flight/flight_step.gd" id="2_step"]

[sub_resource type="Resource" id="Step_1"]
script = ExtResource("2_step")
type = 0
distance = 250.0

[sub_resource type="Resource" id="Step_park"]
script = ExtResource("2_step")
type = 4

[resource]
script = ExtResource("1_pattern")
title = "Земля: выезд сбоку и стоп"
start = Vector2(-0.08, 140.0)
heading = 90.0
steps = [SubResource("Step_1"), SubResource("Step_park")]

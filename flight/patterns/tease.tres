[gd_resource type="Resource" script_class="FlightPattern" format=3]

[ext_resource type="Script" path="res://flight/flight_pattern.gd" id="1_pattern"]
[ext_resource type="Script" path="res://flight/flight_step.gd" id="2_step"]

[sub_resource type="Resource" id="Step_1"]
script = ExtResource("2_step")
distance = 420.0

[sub_resource type="Resource" id="Step_2"]
script = ExtResource("2_step")
type = 2
duration = 0.7
turn_rate = 260.0

[sub_resource type="Resource" id="Step_3"]
script = ExtResource("2_step")
distance = 260.0

[sub_resource type="Resource" id="Step_4"]
script = ExtResource("2_step")
type = 1
angle = 200.0
radius = 150.0

[sub_resource type="Resource" id="Step_5"]
script = ExtResource("2_step")
distance = 240.0

[resource]
script = ExtResource("1_pattern")
title = "Дразнилка: бросок на игрока и уход"
steps = [SubResource("Step_1"), SubResource("Step_2"), SubResource("Step_3"), SubResource("Step_4"), SubResource("Step_5")]

[gd_scene format=3]

[ext_resource type="Script" path="res://scenes/game/level.gd" id="1_script"]
[ext_resource type="Script" path="res://scenes/game/background.gd" id="2_bg"]
[ext_resource type="PackedScene" path="res://scenes/game/player.tscn" id="3_player"]
[ext_resource type="PackedScene" path="res://scenes/game/star_pickup.tscn" id="6_star"]
[ext_resource type="PackedScene" path="res://scenes/ui/hud.tscn" id="7_hud"]
[ext_resource type="PackedScene" path="res://scenes/game/boss.tscn" id="8_boss"]
[ext_resource type="PackedScene" path="res://scenes/game/miniboss.tscn" id="9_miniboss"]
[ext_resource type="Script" path="res://scenes/game/clouds.gd" id="9_clouds"]
[ext_resource type="Script" path="res://scenes/game/camera_shake.gd" id="10_camera"]
[ext_resource type="Script" path="res://scripts/wave_director.gd" id="11_director"]

[node name="Level" type="Node2D"]
script = ExtResource("1_script")
star_scene = ExtResource("6_star")
boss_scene = ExtResource("8_boss")
miniboss_scene = ExtResource("9_miniboss")

[node name="Camera" type="Camera2D" parent="."]
anchor_mode = 0
script = ExtResource("10_camera")

[node name="Background" type="Node2D" parent="."]
z_index = -10
script = ExtResource("2_bg")

[node name="Pickups" type="Node2D" parent="."]

[node name="Enemies" type="Node2D" parent="."]

[node name="Projectiles" type="Node2D" parent="."]

[node name="Player" parent="." instance=ExtResource("3_player")]

[node name="Effects" type="Node2D" parent="." groups=["fx_layer"]]

[node name="Clouds" type="Node2D" parent="."]
z_index = 10
script = ExtResource("9_clouds")

[node name="WaveDirector" type="Node" parent="."]
script = ExtResource("11_director")

[node name="HUD" parent="." instance=ExtResource("7_hud")]
